# PostgreSQL
POSTGRES_DB=ars
POSTGRES_USER=ars
POSTGRES_PASSWORD=ars
# Host ports — change these if another local project already uses the defaults
# (for example: POSTGRES_HOST_PORT=15432, MINIO_HOST_PORT=19000, MINIO_CONSOLE_PORT=19001)
POSTGRES_HOST_PORT=5432
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001

# MinIO (screenshots / traces / PDF evidence storage — used from Phase 2 on)
MINIO_ROOT_USER=ars-minio
MINIO_ROOT_PASSWORD=ars-minio-secret

# Initial administrator account (seeded on first boot only)
ARS_SEED_ADMIN_USERNAME=admin
ARS_SEED_ADMIN_PASSWORD=admin123!

# Browser worker endpoint for the API
# ARS_WORKER_BASE_URL=http://localhost:9100

# Worker -> API callback channel secret (set a strong value in production)
ARS_INTERNAL_TOKEN=ars-dev-internal-token

# Worker local credential store (git-ignored; example under apps/browser-worker/fixtures)
# WORKER_CREDENTIALS_FILE=apps/browser-worker/fixtures/credentials.local.json
